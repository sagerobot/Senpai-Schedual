# GEMINI_API_KEY: Optional. Powers the AI routes (summaries, community vibe,
# recommendation reasons). Without it the server still runs — AI routes return
# 503 { status: "no_key" } and the UI shows AI features as off.
# AI Studio injects this automatically at runtime from user secrets.
GEMINI_API_KEY=""

# PORT: Optional. Defaults to 3000. PaaS platforms (Cloud Run, Render, Fly)
# inject their own value.
PORT=3000

# Daily Gemini call budgets (spend bounds, reset at UTC midnight). Optional.
# grounded = Google-Search-grounded calls (community vibe). Default 100/day.
# text     = plain text calls (summaries + rec reasons).     Default 500/day.
AI_GROUNDED_DAILY_BUDGET=100
AI_TEXT_DAILY_BUDGET=500

# TRUST_PROXY_HOPS: Optional. Number of reverse proxies in front of the app
# (used for correct per-IP rate limiting). Default 1 (Cloud Run/Render/Fly).
TRUST_PROXY_HOPS=1
